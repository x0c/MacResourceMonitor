{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "comment": "Application display name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        }
      }
    },
    "menu.openMainWindow": {
      "comment": "Status menu: open recovery / main window",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Main Window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开主窗口"
          }
        }
      }
    },
    "menu.launchAtLogin": {
      "comment": "Status menu: launch at login, three-state",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at Login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机时打开"
          }
        }
      }
    },
    "menu.openLoginItems": {
      "comment": "Status menu: open System Settings Login Items when approval is pending",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Login Items…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开登录项…"
          }
        }
      }
    },
    "menu.showNetworkSpeed": {
      "comment": "Status menu: show or hide the two-line network speed readout",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Network Speed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示网速"
          }
        }
      }
    },
    "menu.settings": {
      "comment": "Status menu: settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "menu.checkForUpdates": {
      "comment": "Status menu: check for updates",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        }
      }
    },
    "menu.quit": {
      "comment": "Status menu: quit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Mac Resource Monitor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Mac Resource Monitor"
          }
        }
      }
    },
    "status.item.accessibility": {
      "comment": "Menu bar icon accessibility label",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        }
      }
    },
    "panel.freeze": {
      "comment": "Freeze toggle on the compact panel; on = keep the list still",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结"
          }
        }
      }
    },
    "panel.resizeHeight": {
      "comment": "Accessibility label for dragging the compact panel height",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resize height"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整高度"
          }
        }
      }
    },
    "network.empty": {
      "comment": "Network table: no process has network activity in the latest sample",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network activity right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有网络占用"
          }
        }
      }
    },
    "settings.title": {
      "comment": "Recovery / settings window title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor 设置"
          }
        }
      }
    },
    "table.column.app": {
      "comment": "Table column: app name",
