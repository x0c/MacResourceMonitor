{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "comment": "Application display name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        }
      }
    },
    "menu.openMainWindow": {
      "comment": "Status menu: open recovery / main window",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Main Window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开主窗口"
          }
        }
      }
    },
    "menu.launchAtLogin": {
      "comment": "Status menu: launch at login, three-state",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at Login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机时打开"
          }
        }
      }
    },
    "menu.openLoginItems": {
      "comment": "Status menu: open System Settings Login Items when approval is pending",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Login Items…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开登录项…"
          }
        }
      }
    },
    "menu.showNetworkSpeed": {
      "comment": "Status menu: show or hide the two-line network speed readout",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Network Speed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示网速"
          }
        }
      }
    },
    "menu.settings": {
      "comment": "Status menu: settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "menu.checkForUpdates": {
      "comment": "Status menu: check for updates",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        }
      }
    },
    "menu.quit": {
      "comment": "Status menu: quit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Mac Resource Monitor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Mac Resource Monitor"
          }
        }
      }
    },
    "status.item.accessibility": {
      "comment": "Menu bar icon accessibility label",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        }
      }
    },
    "panel.freeze": {
      "comment": "Freeze toggle on the compact panel; on = keep the list still",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结"
          }
        }
      }
    },
    "network.empty": {
      "comment": "Network table: no process has network activity in the latest sample",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network activity right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有网络占用"
          }
        }
      }
    },
    "settings.title": {
      "comment": "Recovery / settings window title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor"
          }
        }
      }
    },
    "settings.status": {
      "comment": "Recovery window status section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "settings.running": {
      "comment": "Recovery window: app is running with icon visible",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor is running. The process table is in the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Resource Monitor 正在运行。进程表在菜单栏里。"
          }
        }
      }
    },
    "table.column.app": {
      "comment": "Table column: app name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "table.column.cpu": {
      "comment": "Table column: CPU percent",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU"
          }
        }
      }
    },
    "table.column.memory": {
      "comment": "Table column: memory percent",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存"
          }
        }
      }
    },
    "table.column.upload": {
      "comment": "Table column: network upload speed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上行"
          }
        }
      }
    },
    "table.column.download": {
      "comment": "Table column: network download speed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下行"
          }
        }
      }
    },
    "table.header.cpu": {
      "comment": "Table header CPU total with percent, e.g. CPU 88.8%",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU %@"
          }
        }
      }
    },
    "table.header.memory": {
      "comment": "Table header memory total with percent, e.g. Mem 68.8%",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mem %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存 %@"
          }
        }
      }
    },
    "table.sort.cpu": {
      "comment": "Accessibility label: sort by CPU, always high to low",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort by CPU"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 CPU 排序"
          }
        }
      }
    },
    "table.sort.memory": {
      "comment": "Accessibility label: sort by memory, always high to low",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort by memory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按内存排序"
          }
        }
      }
    },
    "table.end": {
      "comment": "End process button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束"
          }
        }
      }
    },
    "table.end.disabled.system": {
      "comment": "Why End is disabled for system processes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System processes cannot be ended here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统进程不能从这里结束。"
          }
        }
      }
    },
    "table.end.disabled.otherUser": {
      "comment": "Why End is disabled for other users",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your own processes can be ended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能结束当前用户的进程。"
          }
        }
      }
    },
    "table.end.failed": {
      "comment": "End process failed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not end this process."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能结束这个进程。"
          }
        }
      }
    },
    "settings.general": {
      "comment": "Settings section title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "settings.launchAtLogin": {
      "comment": "Launch at login toggle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机时打开"
          }
        }
      }
    },
    "settings.launchAtLogin.help": {
      "comment": "Launch at login explanation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Turn this on if you want Mac Resource Monitor waiting in the menu bar after you log in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。需要登录后菜单栏里就有它时，再自己打开。"
          }
        }
      }
    },
    "settings.launchAtLogin.needsApproval": {
      "comment": "Launch at login waiting for system approval",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is still waiting for you to allow this in Login Items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统还在等你到「登录项」里批准。"
          }
        }
      }
    },
    "settings.launchAtLogin.openLoginItems": {
      "comment": "Open Login Items in System Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Login Items…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开登录项…"
          }
        }
      }
    },
    "settings.launchAtLogin.failed": {
      "comment": "Launch at login update failed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update Open at Login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能改开机打开。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
