      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU"
          }
        }
      }
    },
    "table.column.memory": {
      "comment": "Table column: memory percent",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存"
          }
        }
      }
    },
    "table.column.upload": {
      "comment": "Table column: network upload speed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上行"
          }
        }
      }
    },
    "table.column.download": {
      "comment": "Table column: network download speed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下行"
          }
        }
      }
    },
    "table.header.cpu": {
      "comment": "Table header CPU total with percent, e.g. CPU 88.8%",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU %@"
          }
        }
      }
    },
    "table.header.memory": {
      "comment": "Table header memory total with percent, e.g. Mem 68.8%",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mem %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存 %@"
          }
        }
      }
    },
    "table.sort.cpu": {
      "comment": "Accessibility label: sort by CPU, always high to low",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort by CPU"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 CPU 排序"
          }
        }
      }
    },
    "table.sort.memory": {
      "comment": "Accessibility label: sort by memory, always high to low",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort by memory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按内存排序"
          }
        }
      }
    },
    "common.cancel": {
      "comment": "Cancel button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "table.end": {
      "comment": "End process button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束"
          }
        }
      }
    },
    "table.end.disabled.system": {
      "comment": "Why End is disabled for system processes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System processes cannot be ended here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统进程不能从这里结束。"
          }
        }
      }
    },
    "table.end.disabled.otherUser": {
      "comment": "Why End is disabled for other users",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your own processes can be ended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能结束当前用户的进程。"
          }
        }
      }
    },
    "table.end.failed": {
      "comment": "End process failed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not end this process."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能结束这个进程。"
          }
        }
      }
    },
    "table.endAll": {
      "comment": "Bulk force-end button in the table header",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force end all listed processes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制结束列表中所有可结束进程"
          }
        }
      }
    },
    "table.endAll.confirm": {
      "comment": "Confirmation button for bulk force-end",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force End All"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部强制结束"
          }
        }
      }
    },
    "table.endAll.confirmation.message": {
      "comment": "Warning shown before bulk force-end",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsaved changes may be lost. Mac Resource Monitor and protected processes will stay open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存的内容可能丢失。Mac Resource Monitor 和受保护进程会保持运行。"
          }
        }
      }
    },
    "table.endAll.confirmation.title": {
      "comment": "Bulk force-end confirmation title; parameter is the number of process rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force end %d processes?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制结束 %d 个进程？"
          }
        }
      }
    },
    "table.endAll.failed": {
      "comment": "Some processes survived bulk force-end",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some processes could not be ended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些进程未能结束。"
          }
        }
      }
    },
    "table.copyName": {
      "comment": "Process row context menu item that copies the displayed name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制名称"
          }
        }
      }
    },
    "table.revealInFinder": {
      "comment": "Process row context menu item that reveals the app or executable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal in Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中显示"
          }
        }
      }
    },
    "table.whitelist.add": {
      "comment": "Process row context menu: protect this row from ending",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to Whitelist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入白名单"
          }
        }
      }
    },
    "table.whitelist.remove": {
      "comment": "Process row context menu: allow ending again",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from Whitelist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移出白名单"
          }
        }
      }
    },
    "table.end.disabled.whitelisted": {
      "comment": "Why End is disabled for whitelisted rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whitelisted — remove from whitelist to end."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在白名单中，移出后才能结束。"
          }
        }
      }
    },
    "settings.whitelist": {
      "comment": "Settings section title for the end-protection list",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whitelist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白名单"
          }
        }
      }
    },
    "settings.whitelist.empty": {
      "comment": "Settings whitelist empty state",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing protected yet. Right-click a row to keep it from being ended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有保护任何进程。在列表里右键一行就能加入。"
          }
        }
      }
    },
    "settings.whitelist.footer": {
      "comment": "Settings whitelist explanation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whitelisted rows cannot be ended, including bulk end and mrm doom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白名单里的行不会被结束，包括表头批量和 mrm doom。"
          }
        }
      }
    },
    "settings.whitelist.remove": {
      "comment": "Settings whitelist row remove button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "settings.general": {
      "comment": "Settings section title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "settings.launchAtLogin": {
      "comment": "Launch at login toggle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机时打开"
          }
        }
      }
    },
    "settings.launchAtLogin.help": {
      "comment": "Launch at login explanation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Turn this on if you want Mac Resource Monitor waiting in the menu bar after you log in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。需要登录后菜单栏里就有它时，再自己打开。"
          }
        }
      }
    },
    "settings.launchAtLogin.needsApproval": {
      "comment": "Launch at login waiting for system approval",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is still waiting for you to allow this in Login Items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统还在等你到「登录项」里批准。"
          }
        }
      }
    },
    "settings.launchAtLogin.openLoginItems": {
      "comment": "Open Login Items in System Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Login Items…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开登录项…"
          }
        }
      }
    },
    "settings.launchAtLogin.failed": {
      "comment": "Launch at login update failed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update Open at Login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能改开机打开。"
          }
        }
      }
    },
    "settings.quit": {
      "comment": "Compact Settings identity row action",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出"
          }
        }
      }
    }
  },
  "version": "1.0"
}
